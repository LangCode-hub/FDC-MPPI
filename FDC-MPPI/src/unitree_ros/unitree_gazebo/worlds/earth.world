                        <diffuse>0.85 0.90 1.0 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="red_marker1">
            <static>true</static>
            <pose>5.1 2 0.025 0 0 0</pose>
            <link name="marker_link">
                <!-- No collision tag: this visual does not participate in physical or laser collisions. -->
                <visual name="marker_visual">
                <geometry>
                    <cylinder>
                    <radius>0.2</radius>
                    <length>0.05</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.8 0.1 0.1 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
                </visual>
            </link>
        </model>

        <model name="ramp0">
            <static>true</static> 
            <link name="ramp_link">
                <pose>1 0.06 -0.04 0 -0.18 0</pose> 
                <collision name="ramp_collision">
                    <geometry>
                        <box>
                            <size>0.8 0.8 0.15</size>
                        </box>
                    </geometry>
                    <surface>
                        <!-- Physical parameters for the sponge material, with corrected tag nesting. -->
                        <friction>
                            <ode>
                                <mu>0.3</mu>
                                <mu2>0.3</mu2>
                                <soft_cfm>0.3</soft_cfm>
                                <soft_erp>0.95</soft_erp>
                            </ode>
                        </friction>
                        <bounce>
                            <restitution_coefficient>0.01</restitution_coefficient>
                            <threshold>0.05</threshold>
                        </bounce>
                        <contact>
                            <surface_layer>0.05</surface_layer>
                        </contact>
                    </surface>
                </collision>
                <visual name="ramp_visual">
                    <geometry>
                        <box>
                            <size>0.8 0.8 0.15</size> 
                        </box>
                    </geometry>
                    <material>
                        <!-- Sponge visual color. -->
                        <ambient>0.8 0.8 0.8 1.0</ambient> 
                        <diffuse>0.9 0.9 0.9 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="ramp1">
            <static>true</static> 
            <link name="ramp_link">
                <pose>1.6 0.06 -0.04 0 -0.18 0</pose> 
                <collision name="ramp_collision">
                    <geometry>
                        <box>
                            <size>0.8 0.8 0.15</size>
                        </box>
                    </geometry>
                    <surface>
