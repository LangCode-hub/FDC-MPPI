<?xml version="1.0" ?>
<sdf version="1.5">
    <world name="default">

        <physics type="ode">
        <max_step_size>0.0002</max_step_size>
        <real_time_factor>1</real_time_factor>
        <real_time_update_rate>5000</real_time_update_rate>
        <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                <type>quick</type>  
                <iters>50</iters> 
                <sor>1.3</sor>
                </solver>  
                <constraints>
                <cfm>0.0</cfm>
                <erp>0.2</erp>
                <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>  
            </ode>
        </physics>

        <scene>
        <sky>
            <clouds>
                <speed>12</speed>
            </clouds>
        </sky>
        </scene>
        <!-- A global light source -->
        <include>
            <uri>model://sun</uri>
        </include>
        <!-- A ground plane -->
        <include>
          <uri>model://ground_plane</uri> 
   
        </include>
        <!-- environment blocks, obstacles or stairs -->
        <model name="static_environment">
        <static>true</static>
            <link name="static_box">
                <pose>3.65 1.15 0.5 0 0 0.4</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="static_box_visual">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.55 0.65 0.8 1.0</ambient>
                        <diffuse>0.85 0.90 1.0 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        
        <model name="static_environment1">
        <static>true</static>
            <link name="static_box">
                <pose>2.05 0.9 0.5 0 0 0</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="static_box_visual">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.55 0.65 0.8 1.0</ambient>
                        <diffuse>0.85 0.90 1.0 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        
        <model name="static_environment2">
        <static>true</static>
            <link name="static_box">
                <pose>3.2 -0.55 0.5 0 0 0.1</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="static_box_visual">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.55 0.65 0.8 1.0</ambient>
                        <diffuse>0.85 0.90 1.0 1.0</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="static_environment3">
        <static>true</static>
            <link name="static_box">
                <pose>4.8 -0.05 0.5 0 0 0.5</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>1.5 0.48 1</size>
                        </box>
